{
  "services": {
    "api": {
      "root": "apps/api",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm install && npx prisma generate && npx prisma migrate deploy && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "api"
      }
    }
  ]
}
