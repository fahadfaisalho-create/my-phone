{
  "expo": {
    "name": "My Phone",
    "slug": "mobile-consumer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platform.mobileconsumer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لتحديد عنوان الزيارة المنزلية بدقة."
      }
    },
    "android": {
      "package": "com.platform.mobileconsumer",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتحديد عنوان الزيارة المنزلية بدقة."
        }
      ]
    ]
  }
}
