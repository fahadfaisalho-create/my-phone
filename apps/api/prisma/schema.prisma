// نموذج قاعدة البيانات لمنصة صيانة وبيع الجوالات
// مطابق لجدول "نموذج قاعدة البيانات" في ملف المواصفات التقنية

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  admin
  merchant_rep
  consumer
}

enum StoreStatus {
  pending
  active
  rejected
  suspended
}

// نوع مزوّد الخدمة: محل/شركة له سجل تجاري، أو فرد مستقل يقدّم الصيانة بنفسه
// (بدون سجل تجاري — يسجل برقم الهوية الوطنية بدلاً منه، بنفس تدفق مراجعة الإدمن)
enum StoreProviderType {
  company
  individual
}

enum SubscriptionPlan {
  monthly
  six_months
  yearly
}

enum SubscriptionStatus {
  active
  expired
}

enum DeviceSupport {
  all
  apple
  samsung
}

enum BookingStatus {
  pending
  accepted
  completed
  cancelled
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum SenderType {
  merchant
  consumer
}

enum TicketRelatedType {
  store
  consumer
}

enum TicketStatus {
  open
  in_progress
  closed
}

// نوع الحجز: المستهلك يروح للمحل، أو موظف/فني المحل يروح لعنوان المستهلك
enum VisitType {
  in_store
  home_visit
}

// طريقة استلام الطلب: من الفرع أو توصيل — التوصيل حالياً بيانات فقط
// (عنوان + رسوم يحددها التاجر)، بانتظار التنسيق مع أرامكس لربط فعلي لاحقاً
enum DeliveryType {
  pickup
  delivery
}

// شركة الشحن التي يختارها المستهلك عند التوصيل — بيانات فقط حالياً
// (بدون ربط API فعلي مع أي شركة)
enum CourierProvider {
  aramex
  fedex
}

// طريقة تنفيذ التوصيل: شركة شحن خارجية (يدوي، بيانات فقط)، أو مندوب تابع للمحل
// نفسه (يتحقق النظام تلقائياً أن عنوان المستهلك داخل نطاق تغطية المحل)
enum DeliveryMethod {
  courier
  store_agent
}

// نوع خصم الكوبون: نسبة مئوية (مع حد أقصى اختياري) أو مبلغ ثابت
enum CouponDiscountType {
  percentage
  fixed
}

// نطاق تطبيق الكوبون: على طلبات الشراء، أو اشتراك المحل بالمنصة، أو كلاهما.
// كوبونات التاجر (المقفلة على متجره) دائماً orders — فقط الإدمن يقدر يصدر
// كوبون يخصم من اشتراك المحل بالمنصة نفسها (subscriptions/both)
enum CouponScope {
  orders
  subscriptions
  both
}

// حالة إرسال الفاتورة الضريبية الإلكترونية لبوابة فاتورة (زاتكا). الاتصال
// الفعلي غير مربوط بعد — not_sent هي الحالة الافتراضية لحد ربطه، والباقي
// (pending/accepted/...) نتائج محاكاة جاهزة لنفس شكل استجابة زاتكا الحقيقية.
enum ZatcaStatus {
  not_sent
  pending
  accepted
  accepted_with_warnings
  rejected
  failed
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  role         UserRole
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  // استعادة كلمة السر (تاجر/إدمن فقط — المستهلك يدخل بـ OTP وما يحتاجها)
  resetToken       String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  stores       Store[]         @relation("StoreOwner")
  bookings     Booking[]       @relation("ConsumerBookings")
  orders       Order[]         @relation("ConsumerOrders")
  chats        Chat[]          @relation("ConsumerChats")
  reviews      Review[]        @relation("ConsumerReviews")

  @@map("users")
}

model Store {
  id                    String      @id @default(cuid())
  ownerUserId           String      @map("owner_user_id")
  owner                 User        @relation("StoreOwner", fields: [ownerUserId], references: [id])
  name                  String
  logoUrl               String?     @map("logo_url")
  // فرد مستقل: بدون سجل تجاري — يُترك فارغاً ويُعبّى nationalId بدلاً منه
  providerType          StoreProviderType @default(company) @map("provider_type")
  commercialRegisterNo  String?     @map("commercial_register_no")
  nationalId            String?     @map("national_id")
  taxNo                 String?     @map("tax_no")
  iban                  String
  // للمحل: ملف السجل التجاري. للفرد المستقل: ملف الهوية/رخصة العمل الحر (نفس الحقل، معنى مختلف)
  crFileUrl             String?     @map("cr_file_url")
  bankCertificateFileUrl String     @map("bank_certificate_file_url")
  status                StoreStatus @default(pending)
  rejectionReason       String?     @map("rejection_reason")
  createdAt             DateTime    @default(now()) @map("created_at")
  // لحظة موافقة الإدمن الفعلية (approve) — تُعرض كـ"تاريخ التحقق" عند الفرد
  // المستقل، وتبقى فارغة لطلب لم يُوافَق عليه بعد
  verifiedAt             DateTime?   @map("verified_at")
  // فقط لمزوّد فرد مستقل (providerType=individual) — تاريخ انتهاء رخصة العمل
  // الحر التي رفعها عند التسجيل
  freelanceLicenseExpiry DateTime?   @map("freelance_license_expiry")

  // خدمة التوصيل للطلبات (منتجات) — يفعّلها التاجر ويحدد رسومها، بيانات فقط حالياً
  // (بانتظار التنسيق مع أرامكس لربط فعلي لاحقاً)
  supportsDelivery Boolean  @default(false) @map("supports_delivery")
  deliveryFee      Decimal? @map("delivery_fee") @db.Decimal(10, 2)

  // توصيل داخلي بمناديب المحل نفسه: نطاق تغطية دائري (نقطة مركزية + نصف قطر
  // بالكيلومتر) وسعر ثابت — النظام يتحقق تلقائياً أن موقع المستهلك داخل النطاق
  supportsAgentDelivery Boolean  @default(false) @map("supports_agent_delivery")
  agentDeliveryFee      Decimal? @map("agent_delivery_fee") @db.Decimal(10, 2)
  agentZoneLat          Float?   @map("agent_zone_lat")
  agentZoneLng          Float?   @map("agent_zone_lng")
  agentZoneRadiusKm     Float?   @map("agent_zone_radius_km")

  branches       Branch[]
  subscriptions  Subscription[]
  services       Service[]
  products       Product[]
  bookings       Booking[]
  orders         Order[]
  chats          Chat[]
  reviews        Review[]
  technicians    Technician[]
  deliveryAgents DeliveryAgent[]
  coupons        Coupon[]
  ads            StoreAd[]
  taxInvoices    TaxInvoice[]

  @@map("stores")
}

// إعلان مميز مدفوع — يشتري التاجر ظهور محله بشريط "إعلانات مميزة" أعلى الرئيسية
// عند المستهلك لعدد أيام محدد، بسعر يومي يضبطه الإدمن. دفع ذاتي محاكى (بدون
// تدخل إدمن) — يصير الإعلان فعّالاً بمجرد الضغط على "ادفع الآن"
model StoreAd {
  id         String    @id @default(cuid())
  storeId    String    @map("store_id")
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  days       Int
  // نسخة من السعر اليومي وقت الشراء (لا تتأثر لو الإدمن غيّر السعر لاحقاً)
  dailyRate  Decimal   @map("daily_rate") @db.Decimal(10, 2)
  totalPrice Decimal   @map("total_price") @db.Decimal(10, 2)
  // تُعبّى فقط بعد تأكيد الدفع — الإعلان غير فعّال قبلها بغض النظر عن أي حقل ثاني
  paidAt     DateTime? @map("paid_at")
  startsAt   DateTime? @map("starts_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("store_ads")
}

// إعدادات عامة للمنصة — صف واحد فقط (id ثابت "default")
model PlatformSettings {
  id           String  @id @default("default")
  adDailyRate  Decimal @default(50) @map("ad_daily_rate") @db.Decimal(10, 2)

  // بيانات البائع الرسمي على الفاتورة الضريبية الإلكترونية — المنصة نفسها هي
  // البائع أمام زاتكا (تُصدر فاتورة المستهلك، ثم تحاسب المحل بمبلغه لاحقاً
  // بشكل منفصل) — الإدمن يعبّيها من إعدادات الفوترة قبل ربط زاتكا فعلياً
  platformLegalName String? @map("platform_legal_name")
  platformVatNo      String? @map("platform_vat_no")
  platformCrNo       String? @map("platform_cr_no")
  // عدّاد فاتورة زاتكا (ICV) — تسلسلي عام على مستوى المنصة كلها، يُستخدم أيضاً
  // لبناء سلسلة تجزئة الفواتير (كل فاتورة تحمل هاش الفاتورة السابقة لها)
  nextInvoiceIcv Int @default(1) @map("next_invoice_icv")

  @@map("platform_settings")
}

// كوبون خصم — يُنشئه الإدمن (storeId فارغ = يعمل على كل المتاجر) أو التاجر
// (storeId معبّى تلقائياً بمتجره — لا يعمل إلا على طلبات هذا المتجر فقط)
model Coupon {
  id           String             @id @default(cuid())
  code         String             @unique
  discountType CouponDiscountType @map("discount_type")
  // للنوع percentage: نسبة 1-100. للنوع fixed: غير مستخدم
  percentage   Decimal?           @db.Decimal(5, 2)
  // للنوع fixed: المبلغ الثابت المخصوم. للنوع percentage: غير مستخدم
  fixedAmount  Decimal?           @map("fixed_amount") @db.Decimal(10, 2)
  // حد أقصى لمبلغ الخصم عند النوع percentage (مثال: 25% بحد أقصى 20 ﷼) — اختياري
  maxDiscount  Decimal?           @map("max_discount") @db.Decimal(10, 2)
  // فارغ = كوبون عام يعمل على كل المتاجر (أنشأه الإدمن)، معبّى = مقفل على متجر واحد فقط
  storeId      String?            @map("store_id")
  store        Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // نطاق التطبيق: طلبات، اشتراكات المحلات بالمنصة، أو كلاهما (افتراضياً طلبات فقط)
  scope        CouponScope        @default(orders)
  startsAt     DateTime?          @map("starts_at")
  expiresAt    DateTime?          @map("expires_at")
  active       Boolean            @default(true)
  // حد أقصى لعدد مرات الاستخدام الكلي — فارغ يعني بلا حد
  usageLimit   Int?               @map("usage_limit")
  usedCount    Int                @default(0) @map("used_count")
  createdAt    DateTime           @default(now()) @map("created_at")

  orders        Order[]
  subscriptions Subscription[]

  @@map("coupons")
}

// مناديب التوصيل التابعين للمحل — قائمة بسيطة يديرها التاجر (اسم ورقم جوال)
model DeliveryAgent {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_agents")
}

// فريق الصيانة — يضيفهم التاجر لبناء مصداقية عند المستهلك (اسم، جنسية، خبرة،
// رخصة عمل حر اختيارية، شهادات متعددة)
model Technician {
  id                      String   @id @default(cuid())
  storeId                 String   @map("store_id")
  store                   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                    String
  nationality             String
  experienceYears         Int?     @map("experience_years")
  photoUrl                String?  @map("photo_url")
  freelanceLicenseNo      String?  @map("freelance_license_no")
  freelanceLicenseFileUrl String?  @map("freelance_license_file_url")
  createdAt               DateTime @default(now()) @map("created_at")

  certificates TechnicianCertificate[]

  @@map("technicians")
}

model TechnicianCertificate {
  id           String     @id @default(cuid())
  technicianId String     @map("technician_id")
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  title        String
  fileUrl      String?    @map("file_url")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("technician_certificates")
}

model Branch {
  id      String  @id @default(cuid())
  storeId String  @map("store_id")
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String
  lat     Float?
  lng     Float?
  address String?

  bookings Booking[]
  products Product[]
  orders   Order[]

  @@map("branches")
}

model Subscription {
  id        String             @id @default(cuid())
  storeId   String             @map("store_id")
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  price     Decimal            @db.Decimal(10, 2)
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  status    SubscriptionStatus @default(active)
  // الإدمن يقدر يؤكد الدفع يدوياً (fallback)، أو تلقائياً عبر Moyasar (invoice + webhook)
  paidAt              DateTime? @map("paid_at")
  gatewayInvoiceId    String?   @map("gateway_invoice_id")

  // كوبون خصم على اشتراك المحل بالمنصة (كوبونات الإدمن فقط) — price أعلاه هو
  // الصافي بعد الخصم، وdiscountAmount محفوظة كسجل لقيمة الخصم وقت التطبيق
  couponId       String?  @map("coupon_id")
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  discountAmount Decimal? @map("discount_amount") @db.Decimal(10, 2)

  // ضريبة القيمة المضافة (15%) على اشتراك المحل بالمنصة — المنصة هي البائع هنا (تبيع
  // خدمة الاشتراك للمحل مباشرة، عكس الطلبات اللي المحل فيها هو البائع)، فتُضاف دائماً.
  // price أعلاه شامل هذا المبلغ (نفس نمط Order.total شامل Order.vatAmount)
  vatAmount Decimal? @map("vat_amount") @db.Decimal(10, 2)

  @@map("subscriptions")
}

model Service {
  id               String        @id @default(cuid())
  storeId          String        @map("store_id")
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  deviceSupport    DeviceSupport @default(all) @map("device_support")
  laborPrice       Decimal       @db.Decimal(10, 2) @map("labor_price")
  linkedProductId  String?       @map("linked_product_id")
  linkedProduct    Product?      @relation(fields: [linkedProductId], references: [id])
  // أنواع الحجز المدعومة لهذه الخدمة — لازم واحد منهم على الأقل مفعّل
  supportsInStore   Boolean      @default(true) @map("supports_in_store")
  supportsHomeVisit Boolean      @default(false) @map("supports_home_visit")
  // رسوم إضافية اختيارية تُضاف فقط عند اختيار الزيارة المنزلية (فوق سعر شغل اليد)
  homeVisitFee      Decimal?     @db.Decimal(10, 2) @map("home_visit_fee")

  bookings Booking[]

  @@map("services")
}

model Product {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  imageUrl    String?  @map("image_url")
  category    String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  // فرع محدد (مخزون منفصل خاص بهذا الفرع فقط) — أو فارغ = مشترك بين كل فروع المحل
  branchId    String?  @map("branch_id")
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  services   Service[]
  orderItems OrderItem[]

  @@map("products")
}

model Booking {
  id          String        @id @default(cuid())
  consumerId  String        @map("consumer_id")
  consumer    User          @relation("ConsumerBookings", fields: [consumerId], references: [id])
  storeId     String        @map("store_id")
  store       Store         @relation(fields: [storeId], references: [id])
  serviceId   String        @map("service_id")
  service     Service       @relation(fields: [serviceId], references: [id])
  branchId    String        @map("branch_id")
  branch      Branch        @relation(fields: [branchId], references: [id])
  scheduledAt DateTime      @map("scheduled_at")
  status      BookingStatus @default(pending)
  // نوع الحجز: بالمحل أو زيارة منزلية — وعنوان المستهلك إلزامي عند الزيارة المنزلية
  visitType       VisitType @default(in_store) @map("visit_type")
  customerAddress String?   @map("customer_address")
  // إحداثيات دقيقة (اختيارية) لموقع الزيارة المنزلية — مأخوذة من موقع الجهاز مباشرة
  customerLat     Decimal?  @map("customer_lat") @db.Decimal(10, 7)
  customerLng     Decimal?  @map("customer_lng") @db.Decimal(10, 7)

  @@map("bookings")
}

model Order {
  id            String        @id @default(cuid())
  consumerId    String        @map("consumer_id")
  consumer      User          @relation("ConsumerOrders", fields: [consumerId], references: [id])
  storeId       String        @map("store_id")
  store         Store         @relation(fields: [storeId], references: [id])
  total         Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  // الإدمن يقدر يؤكد الدفع يدوياً (fallback)، أو تلقائياً عبر Moyasar (invoice + webhook)
  gatewayInvoiceId String?    @map("gateway_invoice_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  // لحظة اكتمال الدفع فعلياً — تُستخدم كتاريخ إصدار الفاتورة (لا فاتورة قبل هذا)
  paidAt            DateTime? @map("paid_at")

  // طريقة الاستلام: من الفرع أو توصيل — والعنوان/الإحداثيات إلزامية عند التوصيل
  deliveryType     DeliveryType     @default(pickup) @map("delivery_type")
  deliveryAddress  String?          @map("delivery_address")
  deliveryLat      Decimal?         @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng      Decimal?         @map("delivery_lng") @db.Decimal(10, 7)
  // نسخة من رسوم التوصيل وقت الطلب (لا تتأثر لو التاجر غيّر الرسوم لاحقاً) + شركة الشحن المختارة
  deliveryFee      Decimal?         @map("delivery_fee") @db.Decimal(10, 2)
  courierProvider  CourierProvider? @map("courier_provider")
  // طريقة تنفيذ التوصيل: شركة شحن خارجية أو مندوب المحل — فارغ لطلبات "استلام من الفرع"
  deliveryMethod   DeliveryMethod?  @map("delivery_method")

  // الفرع الذي اختاره المستهلك للتسوق منه (عند تعدد فروع المحل) — مرجعي لتحديد
  // المنتجات المتاحة والفرز عند التاجر، غير إلزامي (محل بفرع واحد لا يحتاجه)
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id])

  // كوبون الخصم المستخدم (إن وجد) + قيمة الخصم الفعلية وقت الطلب (لا تتأثر
  // لو الكوبون تغيّر أو انتهى لاحقاً) — total أعلاه هو الصافي بعد الخصم
  couponId       String?  @map("coupon_id")
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  discountAmount Decimal? @map("discount_amount") @db.Decimal(10, 2)

  // ضريبة القيمة المضافة (15%) — تُضاف فوق سعر المنتجات (الأسعار قبل الضريبة)، وتُحسب
  // فقط لمتجر مسجّل بضريبة القيمة المضافة (عنده رقم ضريبي وقت الطلب). null يعني بلا ضريبة.
  // نسخة محفوظة وقت الطلب (لا تتأثر لو تسجيل المتجر الضريبي تغيّر لاحقاً) — total أعلاه
  // يشمل هذا المبلغ إن وُجد.
  vatAmount Decimal? @map("vat_amount") @db.Decimal(10, 2)

  items      OrderItem[]
  taxInvoice TaxInvoice?

  @@map("orders")
}

// فاتورة ضريبية إلكترونية (زاتكا) تصدرها المنصة نفسها كبائع رسمي عن كل طلب
// مدفوع — راجع تعليق PlatformSettings.platformVatNo. تُنشأ تلقائياً أول ما
// يتأكد دفع الطلب. الإرسال الفعلي لبوابة فاتورة غير مربوط بعد (راجع
// ZatcaClientService) — status تبقى not_sent لحد ربطه، وبعدها pending ثم
// accepted/rejected/failed حسب رد زاتكا الفعلي.
model TaxInvoice {
  id        String @id @default(cuid())
  invoiceNo String @unique @map("invoice_no")
  // Invoice Counter Value — تسلسل زاتكا العام (لا يتكرر ولا ينقطع) على مستوى المنصة كلها
  icv Int @unique

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id])

  subtotal  Decimal @db.Decimal(10, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // سلسلة التجزئة المطلوبة من زاتكا (كل فاتورة ترتبط بهاش سابقتها) — محسوبة
  // محلياً الآن بخوارزمية مبسطة، تُستبدل بالحساب الرسمي عند الربط الفعلي
  previousInvoiceHash String? @map("previous_invoice_hash")
  invoiceHash         String? @map("invoice_hash")
  zatcaUuid           String? @map("zatca_uuid")
  zatcaQrData         String? @map("zatca_qr_data")

  status        ZatcaStatus @default(not_sent)
  lastError     String?     @map("last_error")
  attempts      Int         @default(0)
  lastAttemptAt DateTime?   @map("last_attempt_at")
  submittedAt   DateTime?   @map("submitted_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("tax_invoices")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model Chat {
  id         String   @id @default(cuid())
  consumerId String   @map("consumer_id")
  consumer   User     @relation("ConsumerChats", fields: [consumerId], references: [id])
  storeId    String   @map("store_id")
  store      Store    @relation(fields: [storeId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  messages Message[]

  @@unique([consumerId, storeId])
  @@map("chats")
}

model Message {
  id         String     @id @default(cuid())
  chatId     String     @map("chat_id")
  chat       Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderType SenderType @map("sender_type")
  senderId   String     @map("sender_id")
  text       String?
  imageUrl   String?    @map("image_url")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  consumerId String   @map("consumer_id")
  consumer   User     @relation("ConsumerReviews", fields: [consumerId], references: [id])
  storeId    String   @map("store_id")
  store      Store    @relation(fields: [storeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([consumerId, storeId])
  @@map("reviews")
}

model SupportTicket {
  id          String            @id @default(cuid())
  relatedType TicketRelatedType @map("related_type")
  relatedId   String            @map("related_id")
  subject     String
  status      TicketStatus      @default(open)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("support_tickets")
}
