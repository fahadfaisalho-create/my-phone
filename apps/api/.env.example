# قاعدة البيانات (Postgres — مثال: Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# المصادقة
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# حساب الأدمن الأولي (يُستخدم عند تشغيل seed فقط)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# منفذ التشغيل
PORT=3000

# البريد (SMTP) — اختياري: إذا تُركت فارغة، تُسجَّل الرسائل في الـ log فقط بدل إرسالها فعلياً
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My Phone <no-reply@example.com>"
